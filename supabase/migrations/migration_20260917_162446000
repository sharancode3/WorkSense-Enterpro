create table public.resume_documents (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  twin_id uuid not null references public.digital_twins(id) on delete cascade,
  storage_path text not null,
  file_name text not null,
  content_type text not null,
  size_bytes integer not null check (size_bytes > 0),
  checksum text not null,
  status text not null default 'uploaded' check (status in ('uploaded','extracted','low_text','reviewed','failed')),
  low_text boolean not null default false,
  page_count integer,
  extracted_text text,
  text_pages jsonb not null default '[]'::jsonb,
  error_code text,
  error_message text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (org_id, twin_id, checksum)
);
create index resume_documents_org_idx on public.resume_documents (org_id, twin_id);
create index resume_documents_status_idx on public.resume_documents (org_id, status);

create table public.resume_versions (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  document_id uuid not null references public.resume_documents(id) on delete cascade,
  twin_id uuid not null references public.digital_twins(id) on delete cascade,
  version integer not null default 1,
  source_hash text not null,
  payload jsonb not null default '{}'::jsonb,
  review_state text not null default 'draft' check (review_state in ('draft','reviewed')),
  reviewed_by uuid references public.digital_twins(id),
  reviewed_at timestamptz,
  created_at timestamptz not null default now(),
  unique (document_id, version)
);
create index resume_versions_doc_idx on public.resume_versions (org_id, document_id);

alter table public.resume_documents enable row level security;
alter table public.resume_versions enable row level security;

create policy resume_docs_read on public.resume_documents for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.resume_documents.org_id)
);
create policy resume_versions_read on public.resume_versions for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.resume_versions.org_id)
);