-- digital_twins
create policy twin_select on public.digital_twins for select using (
  (select id from public.current_twin()) = id
  or ((select role from public.current_twin()) = 'hr_executive' and org_id = (select org_id from public.current_twin()))
  or public.is_team_member(id)
);
create policy twin_write on public.digital_twins for all using (
  (select role from public.current_twin()) = 'hr_executive' and org_id = (select org_id from public.current_twin())
) with check (
  (select role from public.current_twin()) = 'hr_executive' and org_id = (select org_id from public.current_twin())
);
create policy twin_select_hr_partner on public.digital_twins for select using (
  (select role from public.current_twin()) in ('hr_executive','hr_partner') and org_id = (select org_id from public.current_twin())
);
create policy twin_select_recruiter on public.digital_twins for select using (
  (select role from public.current_twin()) = 'recruiter' and org_id = (select org_id from public.current_twin()) and public.digital_twins.role = 'candidate'
);

-- job_requisitions
create policy req_select on public.job_requisitions for select using (
  (select role from public.current_twin()) in ('hr_executive','manager') and org_id = (select org_id from public.current_twin())
);
create policy req_select_hr_recruiter on public.job_requisitions for select using (
  (select role from public.current_twin()) in ('hr_partner','recruiter') and org_id = (select org_id from public.current_twin())
);
create policy req_write on public.job_requisitions for all using (
  (select role from public.current_twin()) = 'hr_executive' and org_id = (select org_id from public.current_twin())
) with check (
  (select role from public.current_twin()) = 'hr_executive' and org_id = (select org_id from public.current_twin())
);

