alter table public.onboarding_tasks add column if not exists twin_id uuid references public.digital_twins(id) on delete cascade;

do $$ begin
  update public.onboarding_tasks t
    set twin_id = p.twin_id
    from public.onboarding_plans p
    where t.plan_id = p.id and t.twin_id is null;
end $$;

create index if not exists onboarding_tasks_twin_idx on public.onboarding_tasks (org_id, twin_id);