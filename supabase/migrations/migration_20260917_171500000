-- Phase 6: structured applications, job-relevant assessments, adaptive interview
-- sessions, reviewer-controlled evaluation.
--
-- 1) applications gets optimistic-concurrency fields (version) so stale-state
--    conflicts are detected server-side (expected_stage/version mismatch -> 409).
-- 2) application_stage_events: append-only transition history (who moved whom,
--    from/to, reason, version, audit ref). Writes happen only in backend
--    functions; authorized transitions are enforced by a server matrix, never
--    by a client dropdown.
-- 3) assessment_blueprints: versioned, job-relevant artifact definitions
--    (instructions, questions, test cases) tied to a requisition + competency.
-- 4) assessment_rubrics: versioned scoring anchors (observable behavior,
--    evidence requirements, 1..5 anchors, critical mistakes,
--    insufficient-evidence conditions, skill mapping for fit provenance).
-- 5) candidate_sessions: scoped invitation-driven sessions (work_sample /
--    interview) with expiration, autosave drafts, immutable submitted answers,
--    a submission hash and a duplicate-submission guard.
--
-- RLS: every new table is org-scoped reads-only; all writes happen through
-- backend functions (service role).

-- 1) Applications: optimistic concurrency for authorized stage transitions.
alter table public.applications add column version integer not null default 1;
alter table public.applications add column updated_at timestamptz not null default now();

-- 2) Append-only stage transition history.
create table public.application_stage_events (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  application_id uuid not null references public.applications(id) on delete cascade,
  actor_twin_id uuid not null references public.digital_twins(id) on delete cascade,
  prior_stage text not null,
  new_stage text not null,
  reason text,
  at timestamptz not null default now(),
  version integer not null,
  audit_ref text
);
create index stage_events_app_idx on public.application_stage_events (org_id, application_id, at);

-- 3) Versioned assessment blueprints (job-relevant artifacts).
create table public.assessment_blueprints (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  requisition_id uuid not null references public.job_requisitions(id) on delete cascade,
  competency text not null,
  version integer not null default 1,
  artifact_spec jsonb not null default '{}'::jsonb,
  test_cases jsonb not null default '[]'::jsonb,
  prompt_adaptation_allowed boolean not null default true,
  created_by uuid references public.digital_twins(id),
  created_at timestamptz not null default now(),
  unique (org_id, requisition_id, competency, version)
);
create index blueprints_org_idx on public.assessment_blueprints (org_id, requisition_id);

-- 4) Versioned scoring rubrics anchored to a blueprint.
create table public.assessment_rubrics (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  blueprint_id uuid not null references public.assessment_blueprints(id) on delete cascade,
  competency text not null,
  version integer not null default 1,
  observable_behavior text not null,
  evidence_requirements jsonb not null default '[]'::jsonb,
  anchors jsonb not null default '{}'::jsonb,
  critical_mistakes jsonb not null default '[]'::jsonb,
  insufficient_evidence_conditions jsonb not null default '[]'::jsonb,
  skill_mapping jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now(),
  unique (org_id, blueprint_id, competency, version)
);
create index rubrics_org_idx on public.assessment_rubrics (org_id, blueprint_id);

-- 5) Candidate sessions (invitation-token scoped).
create table public.candidate_sessions (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  application_id uuid not null references public.applications(id) on delete cascade,
  twin_id uuid not null references public.digital_twins(id) on delete cascade,
  blueprint_id uuid not null references public.assessment_blueprints(id) on delete cascade,
  rubric_id uuid references public.assessment_rubrics(id),
  session_type text not null check (session_type in ('work_sample','interview')),
  invitation_token text not null unique,
  status text not null default 'invited' check (status in ('invited','in_progress','submitted','expired','cancelled')),
  expires_at timestamptz not null,
  time_policy text,
  accommodation jsonb not null default '{}'::jsonb,
  answers jsonb not null default '{}'::jsonb,
  drafts jsonb not null default '{}'::jsonb,
  follow_ups jsonb not null default '[]'::jsonb,
  submitted_at timestamptz,
  submission_hash text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index sessions_org_idx on public.candidate_sessions (org_id, application_id);
create index sessions_twin_idx on public.candidate_sessions (org_id, twin_id, status);
create index sessions_token_idx on public.candidate_sessions (invitation_token);

-- RLS: org-scoped reads only (writes via backend functions).
alter table public.application_stage_events enable row level security;
alter table public.assessment_blueprints enable row level security;
alter table public.assessment_rubrics enable row level security;
alter table public.candidate_sessions enable row level security;

create policy stage_events_read on public.application_stage_events for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.application_stage_events.org_id)
);
create policy blueprints_read on public.assessment_blueprints for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.assessment_blueprints.org_id)
);
create policy rubrics_read on public.assessment_rubrics for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.assessment_rubrics.org_id)
);
create policy sessions_read on public.candidate_sessions for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.candidate_sessions.org_id)
);
