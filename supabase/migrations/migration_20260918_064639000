-- Phase 15 — Demo stability & governance: access administration + credit caching.
create table public.admin_actions (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  actor_twin_id uuid not null references public.digital_twins(id),
  action text not null check (action in ('invite', 'update_role', 'suspend', 'reactivate')),
  target_twin_id uuid references public.digital_twins(id) on delete set null,
  target_email text,
  before_data jsonb not null default '{}'::jsonb,
  after_data jsonb not null default '{}'::jsonb,
  reason text,
  created_at timestamptz not null default now()
);
alter table public.admin_actions enable row level security;
create policy admin_actions_read on public.admin_actions for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.admin_actions.org_id)
);
create index admin_actions_org_created_idx on public.admin_actions(org_id, created_at desc);

alter table public.digital_twins drop constraint digital_twins_status_check;
alter table public.digital_twins add constraint digital_twins_status_check check (
  status in ('candidate', 'active', 'offboarding', 'suspended')
);

create table public.llm_cache (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  task text not null,
  input_hash text not null,
  model text not null,
  output jsonb not null,
  created_at timestamptz not null default now(),
  unique (org_id, task, input_hash)
);
alter table public.llm_cache enable row level security;
create policy llm_cache_read on public.llm_cache for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.llm_cache.org_id)
);
create index llm_cache_org_task_idx on public.llm_cache(org_id, task, created_at desc);