create table public.staffing_scenarios (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  name text not null,
  input_snapshot jsonb not null default '{}'::jsonb,
  assumptions jsonb not null default '{}'::jsonb,
  result jsonb not null default '{}'::jsonb,
  created_by uuid references public.digital_twins(id),
  created_at timestamptz not null default now(),
  unique (org_id, name)
);
create index staffing_scenarios_org_idx on public.staffing_scenarios (org_id, created_at desc);
alter table public.staffing_scenarios enable row level security;
create policy staffing_scenarios_read on public.staffing_scenarios for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.staffing_scenarios.org_id)
);
create table public.staffing_proposals (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  scenario_id uuid references public.staffing_scenarios(id) on delete set null,
  status text not null default 'open' check (status in ('open','approved','declined')),
  submitted_by uuid references public.digital_twins(id),
  review_note text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index staffing_proposals_org_idx on public.staffing_proposals (org_id, status, created_at);
alter table public.staffing_proposals enable row level security;
create policy staffing_proposals_read on public.staffing_proposals for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.staffing_proposals.org_id)
);