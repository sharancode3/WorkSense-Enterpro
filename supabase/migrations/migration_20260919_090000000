-- ===========================================================================
-- WorkSense Phase 34 — durable, event-driven notifications, reminders,
-- digests and workflow-health analytics.
--
--   notifications            — durable, deduplicated, per-recipient records.
--   notification_preferences — per-user delivery/reminder/quiet-hours prefs.
--   notification_events      — audit trail (generation, delivery, read,
--                              snooze, dismiss, action, resolution, prefs,
--                              escalation). Never stores sensitive payloads.
--   notification_digests     — persisted daily/weekly digest facts.
--
-- Authorization: every table is org-scoped and readable only by the owning
-- twin through current_twin(). There are NO client-side writes: all state
-- changes go through the service-role backend functions (notifications,
-- notify-scan). The notifications table is published to realtime so active
-- sessions update live without polling; the recipient filter is enforced in
-- the client subscription AND rows are only ever inserted for authorized
-- recipients by the generator rules.
-- ===========================================================================

create table public.notifications (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  recipient_twin_id uuid not null references public.digital_twins(id) on delete cascade,
  -- Category (what kind of awareness) + severity (how urgent).
  category text not null check (category in (
    'action_required','deadline','blocker','assignment','decision','status_update','security','personal_reminder'
  )),
  severity text not null check (severity in ('critical','high','normal','informational')),
  type text not null,
  title text not null,
  body text not null,
  -- Actor (who/what caused it) and related person (only rendered when the
  -- recipient is authorized; generator rules compute authorization).
  actor_type text not null default 'system' check (actor_type in ('system','user')),
  actor_twin_id uuid,
  actor_name text,
  related_twin_id uuid,
  related_name text,
  -- Canonical source refs (deep links + resolution).
  source_module text not null,
  source_resource_type text not null,
  source_resource_id text not null,
  source_version text,
  source_ref_id text,
  deep_link text,
  action_required boolean not null default false,
  action_label text,
  deadline timestamptz,
  work_item_id text,
  read_at timestamptz,
  snoozed_until timestamptz,
  dismissed_at timestamptz,
  resolved_at timestamptz,
  expires_at timestamptz,
  -- Idempotency: one notification per (recipient, event, source version, rule).
  deduplication_key text not null,
  event_id text not null,
  delivery_channels text[] not null default '{in_app}',
  rule_version int not null default 1,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (org_id, recipient_twin_id, deduplication_key)
);
create index notifications_recipient_idx on public.notifications (org_id, recipient_twin_id, created_at desc);
create index notifications_recipient_read_idx on public.notifications (org_id, recipient_twin_id, read_at);
create index notifications_source_idx on public.notifications (org_id, source_resource_type, source_resource_id);
alter table public.notifications enable row level security;
create policy notifications_owner_read on public.notifications for select using (
  exists (select 1 from public.current_twin() ct
    where ct.org_id = public.notifications.org_id
      and ct.id = public.notifications.recipient_twin_id)
);

create table public.notification_preferences (
  twin_id uuid primary key references public.digital_twins(id) on delete cascade,
  org_id uuid not null references public.organizations(id) on delete cascade,
  in_app boolean not null default true,
  assignments boolean not null default true,
  due_soon boolean not null default true,
  overdue boolean not null default true,
  status_updates boolean not null default true,
  personal_reminders boolean not null default true,
  daily_digest boolean not null default true,
  weekly_digest boolean not null default true,
  quiet_hours_enabled boolean not null default false,
  quiet_hours_start text not null default '22:00',
  quiet_hours_end text not null default '08:00',
  timezone text not null default 'UTC',
  working_days int[] not null default '{1,2,3,4,5}',
  updated_at timestamptz not null default now()
);
alter table public.notification_preferences enable row level security;
create policy notification_prefs_owner_read on public.notification_preferences for select using (
  exists (select 1 from public.current_twin() ct
    where ct.org_id = public.notification_preferences.org_id
      and ct.id = public.notification_preferences.twin_id)
);

create table public.notification_events (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  recipient_twin_id uuid not null references public.digital_twins(id) on delete cascade,
  notification_id uuid,
  event_type text not null check (event_type in (
    'generated','delivered','read','snoozed','dismissed','action_invoked','resolved','prefs_changed','escalated'
  )),
  detail jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now()
);
create index notification_events_recipient_idx on public.notification_events (org_id, recipient_twin_id, created_at desc);
alter table public.notification_events enable row level security;
create policy notification_events_owner_read on public.notification_events for select using (
  exists (select 1 from public.current_twin() ct
    where ct.org_id = public.notification_events.org_id
      and ct.id = public.notification_events.recipient_twin_id)
);

create table public.notification_digests (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  twin_id uuid not null references public.digital_twins(id) on delete cascade,
  period text not null check (period in ('daily','weekly')),
  period_key text not null,
  facts jsonb not null default '[]'::jsonb,
  generated_at timestamptz not null default now(),
  unique (org_id, twin_id, period, period_key)
);
alter table public.notification_digests enable row level security;
create policy notification_digests_owner_read on public.notification_digests for select using (
  exists (select 1 from public.current_twin() ct
    where ct.org_id = public.notification_digests.org_id
      and ct.id = public.notification_digests.twin_id)
);

-- Live delivery for active sessions (recipient-side filter enforced in-app).
alter publication supabase_realtime add table public.notifications;
