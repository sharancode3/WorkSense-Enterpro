alter table public.recommendations drop constraint recommendations_status_check;
alter table public.recommendations add constraint recommendations_status_check check (status in ('suggested','needs_review','approved','rejected','execution_pending','in_progress','completed','failed','cancelled','stale'));
alter table public.recommendations add column version integer not null default 1, add column source_hash text, add column resource_ref text, add column alternatives jsonb not null default '[]'::jsonb, add column required_approvers jsonb not null default '[]'::jsonb, add column expires_at timestamptz, add column stale boolean not null default false, add column stale_reason text, add column superseded_by uuid references public.recommendations(id) on delete set null, add column intended_outcome jsonb not null default '{}'::jsonb, add column approved_at timestamptz, add column last_reviewed_at timestamptz, add column outcomes jsonb not null default '{}'::jsonb;
create index recommendations_source_hash_idx on public.recommendations (org_id, twin_id, source_hash);
alter table public.action_tasks drop constraint action_tasks_status_check;
alter table public.action_tasks add constraint action_tasks_status_check check (status in ('open','in_progress','blocked','completed','failed','cancelled'));
alter table public.action_tasks add column task_code text, add column owner_role text, add column resource_link text, add column instructions text, add column required_evidence jsonb not null default '[]'::jsonb, add column depends_on jsonb not null default '[]'::jsonb, add column outcome_measure jsonb not null default '{}'::jsonb, add column created_by_request_id text, add column version integer not null default 1, add column started_at timestamptz, add column completed_at timestamptz, add column verification jsonb not null default '{}'::jsonb, add column last_error text, add column retry_count integer not null default 0;
alter table public.action_tasks add constraint action_tasks_rec_task_code_key unique (recommendation_id, task_code);
create index action_tasks_rec_idx on public.action_tasks (org_id, recommendation_id, status);
create table public.workflow_events (id uuid primary key default gen_random_uuid(), org_id uuid not null references public.organizations(id) on delete cascade, resource_type text not null check (resource_type in ('recommendation','action_task')), resource_id uuid not null, actor_twin_id uuid, actor_role text, resource text, prior_status text, new_status text, reason text, source_version text, request_id text not null, payload jsonb not null default '{}'::jsonb, created_at timestamptz not null default now(), unique (resource_type, resource_id, request_id));
create index workflow_events_org_idx on public.workflow_events (org_id, resource_type, resource_id, created_at desc);
alter table public.workflow_events enable row level security;
create policy workflow_events_read on public.workflow_events for select using (exists (select 1 from public.current_twin() ct where ct.org_id = public.workflow_events.org_id));