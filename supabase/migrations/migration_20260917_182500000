-- Phase 9: longitudinal workforce review + versioned performance summaries.
--
-- 1) workforce_review_cases: one interpretable review-index row per twin per
--    review period. Stores the deterministic engine output — index (0-100),
--    priority tier, per-factor definitions, trend, data completeness, missing
--    periods, recommended fact-finding, seeking-growth flag (reported
--    SEPARATELY, never as risk), sensitivity flags for individual-level
--    signals, and a source_version_hash for cache invalidation.
-- 2) performance_summaries: evidence-bound performance narratives. Stores the
--    deterministic source facts + inferred themes + contradictions + sparse-
--    evidence flags, and the model narrative that MUST cite those facts.
--    source_version_hash invalidates cached narratives when underlying records
--    change.
--
-- RLS: reads-only, org-scoped (same convention as every table); all writes
-- happen via backend functions with the service role.

create table public.workforce_review_cases (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  twin_id uuid not null references public.digital_twins(id) on delete cascade,
  period_start date not null,
  period_end date not null,
  index integer not null check (index between 0 and 100),
  priority text not null check (priority in ('low','medium','high','review')),
  factors jsonb not null default '{}'::jsonb,
  trend jsonb not null default '[]'::jsonb,
  data_completeness numeric not null default 0 check (data_completeness between 0 and 1),
  missing_data jsonb not null default '[]'::jsonb,
  fact_finding jsonb not null default '[]'::jsonb,
  seeking_growth boolean not null default false,
  sensitivity jsonb not null default '{}'::jsonb,
  limitations jsonb not null default '[]'::jsonb,
  priority_gate jsonb not null default '{}'::jsonb,
  source_version_hash text not null,
  computed_at timestamptz not null default now(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (twin_id, period_start, period_end)
);
create index review_cases_org_idx on public.workforce_review_cases (org_id, twin_id, period_start desc);

create table public.performance_summaries (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.organizations(id) on delete cascade,
  twin_id uuid not null references public.digital_twins(id) on delete cascade,
  period text not null,
  narrative text not null default '',
  source_facts jsonb not null default '[]'::jsonb,
  inferred_themes jsonb not null default '[]'::jsonb,
  contradictions jsonb not null default '[]'::jsonb,
  sparse_evidence jsonb not null default '{}'::jsonb,
  goal_stats jsonb not null default '{}'::jsonb,
  feedback_stats jsonb not null default '{}'::jsonb,
  evidence_summary jsonb not null default '[]'::jsonb,
  source_version_hash text not null,
  model_note text not null default '',
  from_cache boolean not null default false,
  generated_at timestamptz not null default now(),
  reviewed_by uuid references public.digital_twins(id) on delete set null,
  reviewed_at timestamptz,
  unique (twin_id, period)
);
create index perf_summaries_org_idx on public.performance_summaries (org_id, twin_id);

alter table public.workforce_review_cases enable row level security;
alter table public.performance_summaries enable row level security;

create policy review_cases_read on public.workforce_review_cases for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.workforce_review_cases.org_id)
);
create policy performance_summaries_read on public.performance_summaries for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.performance_summaries.org_id)
);
