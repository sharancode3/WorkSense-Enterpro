-- Batch 2.2: replace org-wide read policies with role-scoped reads.
-- A shared security-definer helper encodes the scope model:
--   self / manager-team / HR-org / recruiter-candidates.
-- IT keeps org reads on onboarding plans+tasks only (provisioning subjects);
-- everything else (evidence, fits, resumes, sessions, performance, staffing)
-- is scoped away from IT and from unrelated employees/recruiters.

create or replace function public.can_view_twin(p_twin_id uuid)
returns boolean language sql stable security definer set search_path = public as $$
  select exists (
    select 1
    from public.current_twin() ct
    join public.digital_twins t on t.id = p_twin_id
    where ct.id = t.id
       or (ct.role in ('hr_executive','hr_partner') and ct.org_id = t.org_id)
       or (ct.role = 'manager' and ct.org_id = t.org_id and public.is_team_member(t.id))
       or (ct.role = 'recruiter' and ct.org_id = t.org_id and t.role = 'candidate')
  );
$$;

-- digital_twins: HR partner sees org WORKFORCE only (candidates belong to recruiters).
drop policy if exists twin_select_hr_partner on public.digital_twins;
create policy twin_select_hr_partner on public.digital_twins for select using (
  (select role from public.current_twin()) = 'hr_partner'
  and org_id = (select org_id from public.current_twin())
  and public.digital_twins.role <> 'candidate'
);

-- onboarding plans / tasks: self, manager team, HR org, IT org (provisioning subjects).
drop policy if exists onboarding_plans_read on public.onboarding_plans;
create policy onboarding_plans_read on public.onboarding_plans for select using (
  public.can_view_twin(public.onboarding_plans.twin_id)
  or exists (select 1 from public.current_twin() ct where ct.role = 'it_security' and ct.org_id = public.onboarding_plans.org_id)
);
drop policy if exists onboarding_tasks_read on public.onboarding_tasks;
create policy onboarding_tasks_read on public.onboarding_tasks for select using (
  exists (select 1 from public.onboarding_plans p where p.id = public.onboarding_tasks.plan_id and (public.can_view_twin(p.twin_id) or exists (select 1 from public.current_twin() ct where ct.role = 'it_security' and ct.org_id = p.org_id)))
);
drop policy if exists onboarding_events_read on public.onboarding_task_events;
create policy onboarding_events_read on public.onboarding_task_events for select using (
  exists (select 1 from public.onboarding_plans p where p.id = public.onboarding_task_events.plan_id and public.can_view_twin(p.twin_id))
);

