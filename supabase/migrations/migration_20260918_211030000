  public.can_view_twin(public.staffing_proposals.submitted_by)
  or (exists (select 1 from public.current_twin() ct where ct.role = 'manager' and ct.org_id = public.staffing_proposals.org_id) and exists (select 1 from public.staffing_scenarios s where s.id = public.staffing_proposals.scenario_id and public.can_view_twin(s.created_by)))
);

-- recommendation comments: same scope as the recommendation itself
drop policy if exists rec_comments_select on public.recommendation_comments;
create policy rec_comments_select on public.recommendation_comments for select using (
  exists (select 1 from public.current_twin() ct where ct.org_id = public.recommendation_comments.org_id and ct.role in ('hr_executive','hr_partner'))
  or exists (select 1 from public.recommendations r where r.id = public.recommendation_comments.recommendation_id and public.can_view_twin(r.twin_id))
);

