{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": false
  },
  "include": [
    "types/deno-env.d.ts",
    "supabase/functions/*/index.ts",
    "supabase/functions/_shared/**/*.ts"
  ],
  "exclude": ["supabase/functions/_shared/**/*.test.ts"]
}
